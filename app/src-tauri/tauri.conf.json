{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binder",
  "version": "3.11.0",
  "identifier": "io.github.kungie.binder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Binder",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: https:; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "externalBin": [
      "binaries/binder-cli"
    ],
    "copyright": "AGPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNzk5RUI5MkQ3OEMzNkQKUldSdHczZ3R1WjU1R2d5NkZRVE1XampwVTJDcHJsTzlwRkdOaFM2dnUrUzBROFh5bkcyYWdZWmQK",
      "endpoints": [
        "https://github.com/Kungie/binder/releases/latest/download/latest.json"
      ]
    }
  }
}
